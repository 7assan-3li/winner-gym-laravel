APP_NAME="WINNER GYM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Aden

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker PostgreSQL Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=winner_gym
DB_USERNAME=winner_user
DB_PASSWORD=winner_secret

# Docker Redis (Sessions, Cache, Queue)
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="winner-gym@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Exposed Ports on Host
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API (Fill with your credentials)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Gym Automation
BACKUP_AUTOMATED=false
BACKUP_RETENTION_DAYS=30
BACKUP_ARCHIVE_PASSWORD=
SUBSCRIPTIONS_EXPIRING_SOON_DAYS=7
